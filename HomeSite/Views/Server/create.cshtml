@model HomeSite.Models.CreateServerViewModel

@{
    ViewData["Title"] = "create";
}

<div class=" d-flex text-center align-items-center align-content-center justify-content-center flex-column">
    <h1 class="display-4 text-white">Создать сервер</h1>
    <br />
    <div class="row">
        <div class="">
            <form class="d-flex flex-column gap-2" asp-action="create">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label class="control-label">Название</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">Описание</label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">Ядро</label>
                    <select class="form-select" asp-for="ServerCore" id="serverCore" aria-label="Select version">
                        <option value="" selected>Выберите ядро</option>
                        <option value="VANILLA">Vanilla</option>
                        <option value="PAPER">Paper</option>
                        <option value="PURPUR">Purpur</option>
                        <option value="FORGE">Forge</option>
                        <option value="FABRIC">Fabric</option>
                    </select>
                    <span asp-validation-for="ServerCore" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">Версия</label>
                    <select id="serverVersion" class="form-select" asp-for="Version" aria-label="Select version">
                    </select>
                    <span asp-validation-for="Version" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Создать" class="btn btn-green" />
                </div>
            </form>
        </div>
    </div>

    <div class="mt-2">
        <a asp-action="Index" class="btn btn-primary">Назад</a>
    </div>
</div>
<script src="~/js/serverCreate.js"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
