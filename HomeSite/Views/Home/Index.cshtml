@{
    ViewData["Title"] = "Main Page";
}
<link rel="stylesheet" href="~/css/index.css"/>
<script src="~/js/index.js?v=3"></script>
<div class="text-center">
    @if(Context.User.Identity.Name == null)
    {
        <h1 class="display-4">Велкам</h1>
    }
    else
    {
        <h1 class="display-4">Велкам, @Context.User.Identity.Name</h1>
    }
    <section class="layout">
        <label class="grow1 cpu">
            <h1>CPU</h1>
            <p id="cpu-usage">Использование: 10%</p>
        </label>
        <div class="grow1 gpu">
            <h1>GPU</h1>
            <p id="gpu-usage">Использование: 5%</p>
        </div>
        <div class="grow1 ram">
            <h1>RAM</h1>
            <span id="ram-free">Свободно: 2888 MB</span>
            <span id="ram-usage">Использование: 81%</span>
        </div>
@*         <div class="grow1 temp">
            <h1>Temp</h1>
            <p>avg: 60</p>
        </div> *@
    </section>
    <p class="display-5">Добро пожаловать на экспериментальную сборку!</p>
    <h1 class="display-6 fs-3">Багов много не пугайтесь, эта страница вообще не работает, но остальное функционально</h1>
    <br />
    <br />
    <br />
    <h1 class="display-6 fs-4">В разработке, но в открытом тесте, если интересует что сейчас опять упало и запуститься ли сервер вам <a href="https://t.me/just1xreports">сюда</a></h1>

</div>
