@using static HomeSite.Managers.ConfigManager
@{
    ViewData["Title"] = "Changes";
}
<h1>Изменения</h1>

<p>Открытая бета сайта жастикса</p>

<span id="0.1.2b">
    <a class="link-underline link-underline-opacity-0 text-white" href="#0.1.1b">версия 0.1.2b</a>
    <ul>
        <li>
            Добавлена потдержка мапинга портов (до 3)
            <ul>
                <li>
                    Нескольким плагинам требующим браузер дается свой порт и путь по которому к ним можно обращаться
                </li>
            </ul>
        </li>
        <li>
            Добавлена потдержка красивых описаний серверов и их отображение на сайте
        </li>
