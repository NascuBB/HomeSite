@model AccountViewModel
@{
	ViewData["Title"] = "Account";
}
<link rel="stylesheet" href="~/css/account.css" />
<link rel="stylesheet" href="~/css/serverconf.css" />
<div class=" d-flex text-center align-items-center align-content-center justify-content-center flex-column">
	<div class="d-flex justify-content-center">
		<h1 id="username" class="text-white display-4">Привет @ViewBag.Name</h1>
	</div>

	<h4 class="display-6">Управление аккаунтом</h4>

	<form asp-action="Logout" method="post">
		@Html.AntiForgeryToken()
		<input type="submit" value="Выйти" class="btn btn-danger" />
	</form>
	<div class="d-flex flex-row justify-content-between text-end form-check form-switch form-switch-md mt-4">
		<label class="form-check-label me-5 mt-1" for="ShortLogsSwitch">Получать логи в сокращенном виде</label>
		@if (Model.ShortLogs)
		{
			<input class="form-check-input" type="checkbox" role="switch" id="ShortLogsSwitch" checked>
		}
		else
		{
			<input class="form-check-input" type="checkbox" role="switch" id="ShortLogsSwitch">
		}
		<div id="loadingShortLogs" class="form-check-label loader-sm hideFZ mt-1 ms-2"></div>
	</div>
</div>
<script src="~/js/account.js"></script>